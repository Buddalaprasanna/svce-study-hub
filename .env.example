# Copy this file to ".env" and fill in your real MongoDB Atlas connection string.
# Get it from Atlas: Connect -> Drivers -> Node.js
# Replace <password> with your actual database user password.

MONGODB_URI=mongodb+srv://username:password@svce-study-hub.xxxxx.mongodb.net/svceStudyHub

# Port the backend server runs on (Render will override this automatically in production)
PORT=5000

# Secret password ONLY YOU know — required to upload or delete files.
# Make this something only you'd guess; it's not shown to other users.
ADMIN_UPLOAD_KEY=change-this-to-your-own-secret
